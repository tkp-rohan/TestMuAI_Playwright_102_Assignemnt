    "test:cloud": "cross-env TEST_MODE=cloud playwright test",
    "report": "playwright show-report playwright-report"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.1",
    "cross-env": "^7.0.3",
    "dotenv": "^16.4.7"
  }
}
